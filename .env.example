DOMAIN_NAME=chadscendence.42.fr

# --- Database Configuration ---
# The username for the PostgreSQL database
POSTGRES_USER=user
# The password for the PostgreSQL database
POSTGRES_PASSWORD=password
# The name of the database to create on startup
POSTGRES_DB=chadscendence
# The port the database is exposed on the host
POSTGRES_PORT=5432
# Connection string used by the Backend (NestJS) to connect to the DB
# Note: Inside Docker, we use the service name 'db' and container port 5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# --- Redis Configuration ---
# The hostname of the Redis container (defined in docker-compose)
REDIS_HOST=redis
# The port Redis is listening on (internal container port)
REDIS_CONTAINER_PORT=6379
# The port Redis is exposed on the host
REDIS_PORT=6379

# --- Service Ports & URLs ---
# Ports exposed on the host
BACKEND_PORT=3000
FRONTEND_PORT=5173

# URLs used for cross-service communication and redirects
# These should match the host and ports above when running locally
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- Authentication ---
# Secret key used to sign JWT tokens (change this in production!)
JWT_SECRET=supersecret

# 42 Intra OAuth2 Configuration
INTRA_CLIENT_ID=your_intra_client_id
INTRA_CLIENT_SECRET=your_intra_client_secret
INTRA_CALLBACK_URL=http://localhost:3000/auth/42/callback

# GitHub OAuth2 Configuration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# --- Admin User Configuration ---
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password

# --- Local Path Configuration (Volumes) ---
# These paths are used for Docker bind mounts to persist data on your host machine.
# Relative to the project root.
BACKEND_UPLOADS_PATH=./apps/backend/uploads
