DOMAIN_NAME=chadscendence.42.fr

# --- Database Configuration ---
# The username for the PostgreSQL database
POSTGRES_USER=user
# The password for the PostgreSQL database
POSTGRES_PASSWORD=password
# The name of the database to create on startup
POSTGRES_DB=chadscendence
# Connection string used by the Backend (NestJS) to connect to the DB
DATABASE_URL=postgres://user:password@db:5432/chadscendence

# --- Redis Configuration ---
# The hostname of the Redis container (defined in docker-compose)
REDIS_HOST=redis
# The port Redis is listening on
REDIS_PORT=6379

# --- Authentication ---
# Secret key used to sign JWT tokens (change this in production!)
JWT_SECRET=supersecret

# 42 Intra OAuth2 Configuration
INTRA_CLIENT_ID=your_intra_client_id
INTRA_CLIENT_SECRET=your_intra_client_secret
INTRA_CALLBACK_URL=http://localhost:3000/auth/42/callback

# --- Admin User Configuration ---
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password

# --- Local Path Configuration (Volumes) ---
# These paths are used for Docker bind mounts to persist data on your host machine.
# Relative to the project root.
BACKEND_UPLOADS_PATH=./apps/backend/uploads
