{
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": ".e2e-spec.ts$",
    "transform": {
        "^.+\\.(t|j)sx?$": ["ts-jest", { "useESM": true }]
    },
    "moduleNameMapper": {
        "^@chad/types$": "<rootDir>/../../../libs/types/index.ts",
        "^(\\.\\.?/.*)\\.js$": "$1"
    }
}
